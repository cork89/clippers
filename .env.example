# OpenRouter API Key
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Clippers Configuration
# All settings below are optional and have defaults

# Working directory for intermediate files
# CLIPPERS_WORK_DIR=.work

# Aspect ratios (comma-separated: 1x1,16x9,9x16)
# CLIPPERS_ASPECTS=1x1,16x9,9x16

# Minimum shot duration in seconds
# CLIPPERS_MIN_SHOT_SEC=5

# Maximum words per subtitle line
# CLIPPERS_MAX_WORDS=5

# Background blur strength
# CLIPPERS_BLUR_STRENGTH=20

# Frames per second
# CLIPPERS_FPS=24

# Shader effect (none, wave_displace, edge_glow, liquid_flow, pixel_melt, retro, voronoi)
# CLIPPERS_SHADER=none

# Directory containing shader files
# CLIPPERS_SHADERS_DIR=shaders

# Base font size for subtitles
# CLIPPERS_FONT_SIZE=60

# Subtitle margin from bottom
# CLIPPERS_SUBTITLE_MARGIN=20

# Confidence threshold below which default image is used (0.0-1.0)
# CLIPPERS_DEFAULT_IMAGE_WEIGHT=0.5

# Title context weight (high, medium, low)
# CLIPPERS_TITLE_WEIGHT=high

# Whisper model for transcription
# CLIPPERS_WHISPER_MODEL=distil-medium.en

# LLM Provider (ollama, openrouter)
# CLIPPERS_LLM_PROVIDER=ollama

# Ollama host URL
# CLIPPERS_OLLAMA_HOST=http://localhost:11434

# Vision model for image captioning
# CLIPPERS_VISION_MODEL=gemma3:4b-it-qat

# Model for image selection
# CLIPPERS_SELECT_MODEL=gemma3:4b-it-qat

# Force reprocessing
# CLIPPERS_FORCE=false
