// ./internal/views/segment.templ
package views

import (
	"fmt"

	"github.com/cork89/clippers/internal/types"
)

// SegmentData holds data for rendering the segment editor
type SegmentData struct {
	Index        int
	Entry        types.TimelineEntry
	Transcript   string
	ProjectName  string
	Shader       string
}

// SegmentEditor renders the segment editor panel
templ SegmentEditor(data SegmentData) {
	<div id="editor-panel-content" data-shader={ data.Shader }>
		<input type="hidden" id="segment-start" value={ fmt.Sprintf("%.3f", data.Entry.Start) }/>
		<input type="hidden" id="segment-end" value={ fmt.Sprintf("%.3f", data.Entry.End) }/>
		<div class="segment-preview-container">
			<div class="segment-preview">
				<canvas id="shader-canvas" style="display: none;"></canvas>
				<img
					src={ fmt.Sprintf("/api/image/%s?project=%s", data.Entry.ImageID, data.ProjectName) }
					alt="Segment preview"
					style="max-width: 100%;"
					id="segment-preview-image"
				/>
			</div>
		</div>
		<div class="segment-info">
			<div class="label">Segment { fmt.Sprintf("%d", data.Index) }</div>
			<div class="value">{ data.Transcript }</div>
		</div>
		<div class="segment-actions">
			<button
				class="btn btn-secondary"
				onclick="playSegment()"
			>
				▶ Play Segment
			</button>
		</div>
	</div>
}

// EmptySegmentEditor renders when no segment is selected
templ EmptySegmentEditor() {
	<div id="editor-panel-content">
		<p class="empty-state">Click a segment in the timeline to edit</p>
	</div>
}
