package views

import (
	"fmt"
	"github.com/cork89/clippers/internal/database"
)

type ImagesData struct {
	Images      []database.ImageCaption
	Filter      string
	ProjectName string
}

templ ImageCatalog(data ImagesData) {
	for _, img := range data.Images {
		@ImageCard(img, data.ProjectName)
	}
}

templ ImageCard(img database.ImageCaption, projectName string) {
	<div 
		class="image-card"
		data-image-id={ img.ID }
		hx-post={ fmt.Sprintf("/api/segment/current/image?image_id=%s", img.ID) }
		hx-target="#editor-panel-content"
		hx-swap="innerHTML"
		hx-trigger="click"
		hx-vals={ fmt.Sprintf(`{"image_id": "%s"}`, img.ID) }
	>
		<img 
			src={ fmt.Sprintf("/api/image/%s?project=%s", img.ID, projectName) } 
			alt={ img.Caption }
			onerror="this.style.display='none'"
		/>
		<div class="caption">{ img.Caption }</div>
		if len(img.Tags) > 0 {
			<div class="tags">
				for i, tag := range img.Tags {
					if i < 3 {
						<span class="tag">{ tag }</span>
					}
				}
			</div>
		}
	</div>
}

templ EmptyImages() {
	<div class="loading">
		<p>No images found.</p>
	</div>
}
