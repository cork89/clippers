// ./internal/views/processing.templ
package views

import "fmt"

type ProcessingData struct {
	ProjectName string
	AudioPath   string
	ImagesDir   string
}

templ ProcessingPage(data ProcessingData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Processing Project - Clippers</title>
			<script src="https://unpkg.com/htmx.org@1.9.12" integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body class="processing-page">
			<div class="processing-container">
				<header class="processing-header">
					<div class="logo">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="m7.848 8.25 1.536.887M7.848 8.25a3 3 0 1 1-5.196-3 3 3 0 0 1 5.196 3Zm1.536.887a2.165 2.165 0 0 1 1.083 1.839c.005.351.054.695.14 1.024M9.384 9.137l2.077 1.199M7.848 15.75l1.536-.887m-1.536.887a3 3 0 1 1-5.196 3 3 3 0 0 1 5.196-3Zm1.536-.887a2.165 2.165 0 0 0 1.083-1.838c.005-.352.054-.695.14-1.025m-1.223 2.863 2.077-1.199m0-3.328a4.323 4.323 0 0 1 2.068-1.379l5.325-1.628a4.5 4.5 0 0 1 2.48-.044l.803.215-7.794 4.5m-2.882-1.664A4.33 4.33 0 0 0 10.607 12m3.736 0 7.794 4.5-.802.215a4.5 4.5 0 0 1-2.48-.043l-5.326-1.629a4.324 4.324 0 0 1-2.068-1.379M14.343 12l-2.882 1.664"></path>
						</svg>
						<span>Clippers</span>
					</div>
					<nav class="breadcrumb">
						<a href="/">Projects</a>
						<span class="sep">/</span>
						<span class="current">{ data.ProjectName }</span>
					</nav>
				</header>

				<main class="processing-main">
					<div class="processing-card">
						<div class="card-header">
							<h2>Processing Project</h2>
							<p class="project-name">{ data.ProjectName }</p>
						</div>

						<div class="stages-container" id="stages-container">
							<div class="stage" data-stage="preflight">
								<div class="stage-indicator">
									<div class="indicator-icon">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"/>
										</svg>
									</div>
									<div class="indicator-line"></div>
								</div>
								<div class="stage-content">
									<h3>System Check</h3>
									<p>Verifying dependencies and environment</p>
								</div>
							</div>

							<div class="stage" data-stage="normalize">
								<div class="stage-indicator">
									<div class="indicator-icon">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"/>
										</svg>
									</div>
									<div class="indicator-line"></div>
								</div>
								<div class="stage-content">
									<h3>Normalize Audio</h3>
									<p>Processing and normalizing audio levels</p>
								</div>
							</div>

							<div class="stage" data-stage="transcribe">
								<div class="stage-indicator">
									<div class="indicator-icon">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"/>
										</svg>
									</div>
									<div class="indicator-line"></div>
								</div>
								<div class="stage-content">
									<h3>Transcribe Audio</h3>
									<p>Running Whisper for speech recognition</p>
								</div>
							</div>

							<div class="stage" data-stage="caption">
								<div class="stage-indicator">
									<div class="indicator-icon">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"/>
										</svg>
									</div>
									<div class="indicator-line"></div>
								</div>
								<div class="stage-content">
									<h3>Generate Captions</h3>
									<p>Analyzing images with AI vision model</p>
								</div>
							</div>

							<div class="stage" data-stage="windows">
								<div class="stage-indicator">
									<div class="indicator-icon">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"/>
										</svg>
									</div>
									<div class="indicator-line"></div>
								</div>
								<div class="stage-content">
									<h3>Build Text Windows</h3>
									<p>Creating text segments from transcript</p>
								</div>
							</div>

							<div class="stage" data-stage="plan">
								<div class="stage-indicator">
									<div class="indicator-icon">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"/>
										</svg>
									</div>
								</div>
								<div class="stage-content">
									<h3>Plan Timeline</h3>
									<p>Matching images to audio segments</p>
								</div>
							</div>
						</div>

						<div class="card-footer" id="process-actions">
							<button 
								class="btn btn-primary btn-large" 
								id="process-btn"
								hx-post="/api/process"
								hx-headers={ fmt.Sprintf(`{"project": "%s"}`, data.ProjectName) }
								hx-target="#process-actions"
								hx-swap="innerHTML"
							>
								<span class="btn-icon">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
										<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
									</svg>
								</span>
								Start Processing
							</button>
							<p class="processing-note">This may take a few minutes depending on audio length and image count.</p>
						</div>
					</div>
				</main>
			</div>
			<script src="/static/app.js"></script>
			<script>
				document.body.addEventListener('htmx:beforeRequest', function(evt) {
					if (evt.detail.pathInfo.requestPath === '/api/process') {
						document.getElementById('process-btn').classList.add('loading');
						document.getElementById('process-btn').disabled = true;
						startPolling();
					}
				});

				document.body.addEventListener('htmx:afterRequest', function(evt) {
					if (evt.detail.pathInfo.requestPath === '/api/process') {
						document.getElementById('process-btn').classList.remove('loading');
					}
				});

				let pollInterval = null;

				function updateStageClasses(currentStage) {
					const stages = document.querySelectorAll('.stage');
					stages.forEach(function(stage, index) {
						stage.classList.remove('pending', 'running', 'complete', 'failed');
						if (currentStage > index) {
							stage.classList.add('complete');
						} else if (currentStage === index) {
							stage.classList.add('running');
						} else {
							stage.classList.add('pending');
						}
					});
				}

				function startPolling() {
					if (pollInterval) return;
					pollInterval = setInterval(function() {
						htmx.ajax('GET', '/api/process/status', {
							target: '#stages-container',
							swap: 'innerHTML'
						}).then(function() {
							const stagesContainer = document.getElementById('stages-container');
							if (stagesContainer) {
								const currentStageEl = stagesContainer.querySelector('.stage.running');
								if (currentStageEl) {
									const stages = Array.from(stagesContainer.querySelectorAll('.stage'));
									const currentIdx = stages.indexOf(currentStageEl);
									updateStageClasses(currentIdx);
								} else {
									const complete = stagesContainer.querySelector('.stage.complete');
									const failed = stagesContainer.querySelector('.stage.failed');
									if (complete || failed) {
										stopPolling();
									}
								}
							}
						});
					}, 2000);
				}

				function stopPolling() {
					if (pollInterval) {
						clearInterval(pollInterval);
						pollInterval = null;
					}
				}

				function checkComplete() {
					const complete = document.querySelector('.stage.complete');
					const failed = document.querySelector('.stage.failed');
					if (complete || failed) {
						stopPolling();
					}
				}
			</script>
		</body>
	</html>
}

templ ProcessingStages(currentStage int, failedStage int, failedError string) {
	<div class="stages-container" id="stages-container">
		<div class="stage" data-stage="preflight">
			<div class="stage-indicator">
				<div class="indicator-icon">
					<span class="icon-content">
						if currentStage > 0 {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						} else if currentStage == 0 {
							<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						} else {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
						}
					</span>
				</div>
				<div class="indicator-line"></div>
			</div>
			<div class="stage-content">
				<h3>System Check</h3>
				if currentStage == 0 {
					<p class="running-text">Verifying dependencies and environment...</p>
				} else {
					<p>Verifying dependencies and environment</p>
				}
			</div>
		</div>

		<div class="stage" data-stage="normalize">
			<div class="stage-indicator">
				<div class="indicator-icon">
					<span class="icon-content">
						if currentStage > 1 {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						} else if currentStage == 1 {
							<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						} else {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
						}
					</span>
				</div>
				<div class="indicator-line"></div>
			</div>
			<div class="stage-content">
				<h3>Normalize Audio</h3>
				if currentStage == 1 {
					<p class="running-text">Processing and normalizing audio levels...</p>
				} else {
					<p>Processing and normalizing audio levels</p>
				}
			</div>
		</div>

		<div class="stage" data-stage="transcribe">
			<div class="stage-indicator">
				<div class="indicator-icon">
					<span class="icon-content">
						if currentStage > 2 {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						} else if currentStage == 2 {
							<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						} else {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
						}
					</span>
				</div>
				<div class="indicator-line"></div>
			</div>
			<div class="stage-content">
				<h3>Transcribe Audio</h3>
				if currentStage == 2 {
					<p class="running-text">Running Whisper for speech recognition...</p>
				} else {
					<p>Running Whisper for speech recognition</p>
				}
			</div>
		</div>

		<div class="stage" data-stage="caption">
			<div class="stage-indicator">
				<div class="indicator-icon">
					<span class="icon-content">
						if currentStage > 3 {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						} else if currentStage == 3 {
							<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						} else {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
						}
					</span>
				</div>
				<div class="indicator-line"></div>
			</div>
			<div class="stage-content">
				<h3>Generate Captions</h3>
				if currentStage == 3 {
					<p class="running-text">Analyzing images with AI vision model...</p>
				} else {
					<p>Analyzing images with AI vision model</p>
				}
			</div>
		</div>

		<div class="stage" data-stage="windows">
			<div class="stage-indicator">
				<div class="indicator-icon">
					<span class="icon-content">
						if currentStage > 4 {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						} else if currentStage == 4 {
							<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						} else {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
						}
					</span>
				</div>
				<div class="indicator-line"></div>
			</div>
			<div class="stage-content">
				<h3>Build Text Windows</h3>
				if currentStage == 4 {
					<p class="running-text">Creating text segments from transcript...</p>
				} else {
					<p>Creating text segments from transcript</p>
				}
			</div>
		</div>

		<div class="stage" data-stage="plan">
			<div class="stage-indicator">
				<div class="indicator-icon">
					<span class="icon-content">
						if currentStage > 5 {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						} else if currentStage == 5 {
							<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
						} else {
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
						}
					</span>
				</div>
			</div>
			<div class="stage-content">
				<h3>Plan Timeline</h3>
				if currentStage == 5 {
					<p class="running-text">Matching images to audio segments...</p>
				} else {
					<p>Matching images to audio segments</p>
				}
			</div>
		</div>
	</div>
}

templ ProcessingProgressUI(projectName string) {
	<div class="processing-loading-mini">
		<svg class="spinner-mini" viewBox="0 0 24 24">
			<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="60" stroke-dashoffset="20"/>
		</svg>
	</div>
}

templ ProcessingCompleteUI(projectName string) {
	<div class="processing-complete">
		<div class="complete-content">
			<div class="success-icon-large">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</div>
			<h3>Processing Complete!</h3>
			<p>Your project is ready to edit.</p>
			<a href={ templ.SafeURL("/projects/" + projectName) } class="btn btn-success btn-large">
				<span class="btn-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
					</svg>
				</span>
				Open Editor
			</a>
		</div>
	</div>
}

templ ProcessingErrorUI(message string, projectName string) {
	<div class="processing-error">
		<div class="error-content">
			<div class="error-icon-large">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
			</div>
			<h3>Processing Failed</h3>
			<p class="error-detail">{ message }</p>
			<button 
				class="btn btn-primary btn-large" 
				hx-post="/api/process"
				hx-headers={ fmt.Sprintf(`{"project": "%s"}`, projectName) }
				hx-target="#process-actions"
				hx-swap="innerHTML"
			>
				<span class="btn-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
					</svg>
				</span>
				Try Again
			</button>
		</div>
	</div>
}
